    "@fontsource/montserrat": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@sentry/electron": "^7.20.2",
    "@sentry/vite-plugin": "^4.9.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.14.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.61.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
